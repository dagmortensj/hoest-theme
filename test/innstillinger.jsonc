// JSON med kommentarer, som settings.json i VS Code
{
  /* Blokkommentar */
  "workbench.colorTheme": "Høstkveld",
  "editor.fontSize": 14,
  "editor.fontFamily": "MesloLGS Nerd Font, monospace",
  "editor.bracketPairColorization.enabled": true,
  "editor.rulers": [80, 120],
  "files.exclude": { "**/*.aux": true, "**/.DS_Store": true },
  "[python]": { "editor.tabSize": 4 },
  "editor.tokenColorCustomizations": null,
  // Vanskelige tilfeller
  "workbench.colorCustomizations": { "[Høstkveld]": { "editor.background": "#211e17" } },
  "editor.semanticTokenColorCustomizations": { "[Høstkveld]": { "rules": { "parameter": { "italic": true } } } },
  "files.associations": { "*.tex": "latex", "**/.p10k.zsh": "shellscript" },
  "latex-workshop.latex.tools": [{ "name": "latexmk", "command": "latexmk", "args": ["-lualatex", "-interaction=nonstopmode", "%DOC%"] }],
  "terminal.integrated.fontSize": 13.5, "window.zoomLevel": -0.5, "editor.wordWrapColumn": 1e2,
  /* "utkommentert": "a + b == c", */ "tekst": "a + b == c // ikke kommentar",
  "terminal.integrated.env.osx": { "PATH": "${env:PATH}:/opt/homebrew/bin" }, // til slutt
}
