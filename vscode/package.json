{
  "name": "hoest-theme",
  "displayName": "Høst Theme",
  "description": "A light and a dark theme in comfortable earth tones: Høstlys (autumn light) and Høstkveld (autumn evening). Høst is Norwegian for autumn. Tuned for LaTeX and Python, with the same colour roles in TypeScript, JavaScript, Java, C#, C++, Go, Rust and more, and across the whole workbench. A status bar button switches between light and dark.",
  "version": "3.10.0",
  "publisher": "dagmortensj",
  "author": { "name": "Dag-Morten Sjøstrøm" },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#211e17",
    "theme": "dark"
  },
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagmortensj/hoest-theme"
  },
  "homepage": "https://github.com/dagmortensj/hoest-theme#readme",
  "bugs": {
    "url": "https://github.com/dagmortensj/hoest-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": ["autumn", "earth tones", "warm", "light theme", "dark theme", "fall", "earthy", "brown", "rustic", "retro", "cozy", "nostalgic", "muted", "light and dark", "color theme", "latex", "latex workshop", "python", "pylance", "iterm", "terminal", "høst", "hoest", "norwegian", "gruvbox"],
  "contributes": {
    "commands": [
      {
        "command": "hoest.toggle",
        "title": "Switch between Høstlys and Høstkveld",
        "category": "Høst"
      }
    ],
    "themes": [
      {
        "label": "Høstlys",
        "uiTheme": "vs",
        "path": "./themes/hoestlys-color-theme.json"
      },
      {
        "label": "Høstkveld",
        "uiTheme": "vs-dark",
        "path": "./themes/hoestkveld-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "latex.hoest.injection",
        "path": "./syntaxes/latex-hoest.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikzenv.injection",
        "path": "./syntaxes/latex-hoest-tikz-environments.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikz.injection",
        "path": "./syntaxes/latex-hoest-tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.options.injection",
        "path": "./syntaxes/latex-hoest-options.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.operators.injection",
        "path": "./syntaxes/latex-hoest-operators.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hoest.toggle"
  ]
}
