{
  "name": "hoest-theme",
  "displayName": "Høst Theme",
  "description": "Høstlys and Høstkveld: a light and a dark theme in earth tones, tuned for LaTeX and Python. Høst is Norwegian for autumn. Covers the whole workbench, LaTeX, Python with Pylance semantic highlighting, Markdown, BibTeX, JSON, YAML, shell and diff. Adds a status bar button that switches between light and dark.",
  "version": "3.6.1",
  "publisher": "dagmortensj",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#211e17",
    "theme": "dark"
  },
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagmortensj/hoest-theme"
  },
  "homepage": "https://github.com/dagmortensj/hoest-theme#readme",
  "bugs": {
    "url": "https://github.com/dagmortensj/hoest-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": ["theme", "color theme", "light theme", "dark theme", "light", "dark", "autumn", "fall", "earth tones", "warm", "norwegian", "gruvbox", "latex", "python"],
  "contributes": {
    "commands": [
      {
        "command": "hoest.toggle",
        "title": "Switch between Høstlys and Høstkveld",
        "category": "Høst"
      }
    ],
    "themes": [
      {
        "label": "Høstlys",
        "uiTheme": "vs",
        "path": "./themes/hoestlys-color-theme.json"
      },
      {
        "label": "Høstkveld",
        "uiTheme": "vs-dark",
        "path": "./themes/hoestkveld-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "latex.hoest.injection",
        "path": "./syntaxes/latex-hoest.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikzenv.injection",
        "path": "./syntaxes/latex-hoest-tikz-environments.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikz.injection",
        "path": "./syntaxes/latex-hoest-tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.options.injection",
        "path": "./syntaxes/latex-hoest-options.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hoest.toggle"
  ]
}
