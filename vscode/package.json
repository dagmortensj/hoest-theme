{
  "name": "hoest-theme",
  "displayName": "Høst Theme",
  "description": "A dark and a light theme in comfortable earth tones: Høstkveld (autumn evening) and Høstlys (autumn light). A status bar button switches between them. Covers most languages, see details below.",
  "version": "3.11.3",
  "publisher": "dagmortensj",
  "author": { "name": "Dag-Morten Sjøstrøm" },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#211e17",
    "theme": "dark"
  },
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/dagmortensj/hoest-theme"
  },
  "homepage": "https://github.com/dagmortensj/hoest-theme#readme",
  "bugs": {
    "url": "https://github.com/dagmortensj/hoest-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": ["autumn", "earth tones", "warm", "light theme", "dark theme", "fall", "earthy", "brown", "rustic", "retro", "cozy", "nostalgic", "muted", "light and dark", "color theme", "latex", "latex workshop", "python", "pylance", "iterm", "terminal", "høst", "hoest", "norwegian", "gruvbox"],
  "contributes": {
    "commands": [
      {
        "command": "hoest.toggle",
        "title": "Switch between Høstlys and Høstkveld",
        "category": "Høst"
      }
    ],
    "themes": [
      {
        "label": "Høstlys",
        "uiTheme": "vs",
        "path": "./themes/hoestlys-color-theme.json"
      },
      {
        "label": "Høstkveld",
        "uiTheme": "vs-dark",
        "path": "./themes/hoestkveld-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "latex.hoest.injection",
        "path": "./syntaxes/latex-hoest.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikzenv.injection",
        "path": "./syntaxes/latex-hoest-tikz-environments.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.tikz.injection",
        "path": "./syntaxes/latex-hoest-tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.options.injection",
        "path": "./syntaxes/latex-hoest-options.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.hoest.operators.injection",
        "path": "./syntaxes/latex-hoest-operators.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "python.hoest.operators.injection",
        "path": "./syntaxes/python-hoest-operators.injection.json",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "scopeName": "hoest.operators.injection",
        "path": "./syntaxes/hoest-operators.injection.json",
        "injectTo": [
          "source.go",
          "source.java",
          "source.cpp",
          "source.php",
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "lua.hoest.operators.injection",
        "path": "./syntaxes/lua-hoest-operators.injection.json",
        "injectTo": [
          "source.lua"
        ]
      },
      {
        "scopeName": "swift.hoest.operators.injection",
        "path": "./syntaxes/swift-hoest-operators.injection.json",
        "injectTo": [
          "source.swift"
        ]
      },
      {
        "scopeName": "julia.hoest.operators.injection",
        "path": "./syntaxes/julia-hoest-operators.injection.json",
        "injectTo": [
          "source.julia"
        ]
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hoest.toggle"
  ]
}
