{
  "$comment": "Høst: circuitikz and tikzcd are drawn with tikz, but LaTeX Workshop does not recognise them. This rule gives them the same scope as tikzpicture.",
  "scopeName": "latex.host.tikzenv.injection",
  "injectionSelector": "L:text.tex.latex -comment -markup.raw -source -meta.embedded -meta.function.environment.latex.tikz",
  "patterns": [
    {
      "begin": "(?:\\s*)((\\\\)begin)(\\{)(circuitikz|tikzcd)(\\})",
      "beginCaptures": {
        "1": {
          "name": "support.function.be.latex"
        },
        "2": {
          "name": "punctuation.definition.function.latex"
        },
        "3": {
          "name": "punctuation.definition.arguments.begin.latex"
        },
        "4": {
          "name": "variable.parameter.function.latex"
        },
        "5": {
          "name": "punctuation.definition.arguments.end.latex"
        }
      },
      "end": "((\\\\)end)(\\{)(\\4)(\\})",
      "endCaptures": {
        "1": {
          "name": "support.function.be.latex"
        },
        "2": {
          "name": "punctuation.definition.function.latex"
        },
        "3": {
          "name": "punctuation.definition.arguments.begin.latex"
        },
        "4": {
          "name": "variable.parameter.function.latex"
        },
        "5": {
          "name": "punctuation.definition.arguments.end.latex"
        }
      },
      "name": "meta.function.environment.latex.tikz",
      "patterns": [
        {
          "include": "text.tex.latex"
        }
      ]
    }
  ]
}
