{
  "$comment": "Høst: colours the contents of tikzpicture, which the LaTeX Workshop grammar leaves as plain text. Numbers and units, option keys and the words of a path (node, at, cycle, circle ...) get their own scopes. Applies only inside tikzpicture, outside maths and comments.",
  "scopeName": "latex.host.tikz.injection",
  "injectionSelector": "L:meta.function.environment.latex.tikz -meta.math -comment -string -support.class.math",
  "patterns": [
    {
      "comment": "Option keys: [line width=1pt, scale=1.2]",
      "match": "(?:(?<=[\\[{])|(,))(\\s*)([A-Za-z][\\w \\-<>^_]*?)(\\s*)(=)",
      "captures": {
        "3": {
          "name": "support.type.property-name.tikz"
        },
        "5": {
          "name": "punctuation.separator.key-value.tikz"
        }
      }
    },
    {
      "comment": "The words of a path, only where they belong",
      "match": "\\b(?:(node|coordinate|pic)(?=\\s*[\\[({])|(at)(?=\\s*\\()|(cycle)\\b|(circle|ellipse|arc)(?=\\s*[\\[(])|(rectangle|grid|controls|and)(?=\\s*[\\[(+])|(to|edge)(?=\\s*[\\[(])|(plot)(?=\\s*[\\[({c])|(child)(?=\\s*[\\[{]))",
      "name": "keyword.other.path.tikz"
    },
    {
      "comment": "Numbers, with or without a unit: 0.18  -4  1.6pt  2cm",
      "match": "(?<![\\w.!])(-?(?:\\d+\\.?\\d*|\\.\\d+))(pt|cm|mm|em|ex|in|bp|sp|mu)?(?![\\w])",
      "captures": {
        "1": {
          "name": "constant.numeric.tikz"
        },
        "2": {
          "name": "keyword.other.unit.tikz"
        }
      }
    }
  ]
}
